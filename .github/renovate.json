{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "group:allNonMajor",
    "schedule:earlyMondays"
  ],
  "labels": ["dependencies"],
  "timezone": "America/Toronto",
  "automerge": true,
  "major": {
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates separately from standard dependencies",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    }
  ],
  "customManagers": [
    {
      "description": "wasm-pack version installed in CI",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["tool: wasm-pack@(?<currentValue>\\S+)"],
      "datasourceTemplate": "crate",
      "depNameTemplate": "wasm-pack"
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": false,
    "labels": ["security", "dependencies"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  }
}
